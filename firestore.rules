rules_version = '2';

// ================================================================
//  학생회 사이트 보안 규칙
//  최고 관리자: 학생회 공용 gmail (js/config.js 의 ownerEmail 과 같아야 함)
//  공용 gmail을 바꾸게 되면 아래 주소와 config.js 를 함께 바꾸세요.
// ================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() { return 'kudl.council@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == ownerEmail().lower();
    }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(myDoc()).data; }
    function hasProfile() { return signedIn() && exists(myDoc()); }
    function approved() { return isOwner() || (hasProfile() && me().status == 'approved'); }
    // 임기를 마친 OB (탈퇴자는 제외): 사업 기록과 학생회 멤버 명단만 읽기 가능
    function alumni() {
      return hasProfile() && me().status == 'inactive' && me().get('inactiveReason', '') == '임기 종료';
    }
    function admin() { return isOwner() || (approved() && me().get('isAdmin', false) == true); }
    // 지금 학생회(관리 → 사이트 설정) / 내가 속했던 학생회(넘기기 때 기록됨) / 2학년 여부
    function siteDoc() { return /databases/$(database)/documents/settings/site; }
    function curGen() { return exists(siteDoc()) ? get(siteDoc()).data.get('generation', '') : ''; }
    function wasIn(g) { return g in me().get('generations', []); }
    // 지금 학생회 것은 활동 중인 모두, 지난 학생회 것은 그 학생회에 있었던 사람만
    function canSeeGen(g) { return approved() && (g == curGen() || (hasProfile() && wasIn(g))); }
    function senior() { return approved() && hasProfile() && me().get('grade', '') == '2학년'; }
    function unchanged(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }

    // ---- 회원 정보 (연락망) ----
    match /users/{uid} {
      // 본인 정보는 본인이, 전체 명단은 승인된 회원만
      allow read: if (signedIn() && request.auth.uid == uid) || approved();

      // 가입 신청: 본인 것만, 반드시 '승인 대기' 상태로 (공용계정은 예외)
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && (isOwner() || (request.resource.data.status == 'pending'
                          && request.resource.data.isAdmin == false
                          && request.resource.data.keys().hasOnly(['name', 'studentId', 'grade', 'dept', 'position',
                               'phone', 'obPhone', 'email', 'status', 'isAdmin', 'createdAt'])));

      // 수정: 회장단은 모두 가능 / 본인은 이름·학번·전화번호만
      //   - 학년·소속 국서·직책·지난 학생회 기록은 회장단만 바꿀 수 있음
      //     (1학년이 스스로 2학년으로 바꿔서 타임캡슐 등을 보는 것을 막음)
      //   - 승인 대기 중이거나 재신청할 때는 정보를 고칠 수 있음 (회장단이 확인 후 승인)
      //   - 상태 변경은 두 가지만: 스스로 탈퇴(활동 중 → 탈퇴), 재신청(종료·반려 → 승인 대기)
      allow update: if admin() || (
        signedIn() && request.auth.uid == uid
        && unchanged('email') && unchanged('generations') && unchanged('history')
        && (unchanged('isAdmin') || request.resource.data.isAdmin == false)
        && (
          // 승인 대기 중: 가입 정보 수정
          (resource.data.status == 'pending' && unchanged('status') && unchanged('inactiveReason'))
          // 활동 중·OB: 이름·학번·전화번호 (+ 홈 '선배의 한마디' 숨기기 설정)만
          || (unchanged('status') && unchanged('inactiveReason')
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['name', 'studentId', 'phone', 'obPhone', 'profileCheck', 'hideHomeMsg', 'updatedAt']))
          // 학년이 비어 있던 예전 회원: 학년 한 번 입력
          || (resource.data.status == 'approved' && unchanged('status') && unchanged('inactiveReason')
              && resource.data.get('grade', '') == ''
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['grade', 'name', 'studentId', 'phone', 'obPhone', 'profileCheck', 'updatedAt']))
          // 스스로 탈퇴
          || (resource.data.status == 'approved'
              && request.resource.data.status == 'inactive'
              && request.resource.data.inactiveReason == '탈퇴'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'inactiveReason', 'isAdmin', 'phone', 'leftAt']))
          // 재신청 (다시 승인 대기로)
          || (resource.data.status in ['inactive', 'rejected']
              && request.resource.data.status == 'pending'
              && request.resource.data.isAdmin == false)
        )
      );

      allow delete: if admin();
    }

    // ---- 역대 학생회 기록 (멤버 이름·국·직책·번호) ----
    //   번호가 들어 있으므로 그 학생회 멤버였던 사람과 회장단만 볼 수 있음
    match /councils/{id} {
      allow read: if admin()
        || (signedIn() && request.auth.uid in resource.data.get('memberUids', []));
      allow write: if admin();
    }

    // ---- 선배들의 한마디 (공개된 것): 활동 중인 회원과 OB가 읽기
    //   OB는 바로 공개로 쓸 수 있음. 회장단은 인수인계 때 타임캡슐을 여기로 옮김
    //   그 학생회에 함께 있었던 후배(넘기기 후 남은 사람)와 쓴 사람만 읽기
    match /messages/{id} {
      allow read: if admin()
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (approved() && hasProfile() && wasIn(resource.data.generation));
      allow create: if admin()
        || ((approved() || alumni()) && request.resource.data.authorUid == request.auth.uid);
      allow update: if admin() || ((approved() || alumni())
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid);
      allow delete: if admin() || ((approved() || alumni())
        && resource.data.authorUid == request.auth.uid);
    }

    // ---- 타임캡슐 (봉인된 한마디): 2학년끼리만 읽고 씀. 인수인계 때 공개됨
    match /capsules/{id} {
      allow read: if admin()
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (senior() && resource.data.generation == curGen());
      allow create: if senior() && request.resource.data.authorUid == request.auth.uid;
      allow update: if admin() || (approved()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid);
      allow delete: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ---- 소통방 자유게시판 · 댓글: 활동 중인 회원끼리
    match /talk/{id} {
      allow read: if admin() || canSeeGen(resource.data.generation);
      allow create: if approved() && request.resource.data.authorUid == request.auth.uid;
      allow update: if approved() && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if admin() || (approved() && resource.data.authorUid == request.auth.uid);
    }
    match /talkComments/{id} {
      allow read: if admin() || canSeeGen(resource.data.generation);
      allow create: if approved() && request.resource.data.authorUid == request.auth.uid;
      allow delete: if admin() || (approved() && resource.data.authorUid == request.auth.uid);
    }

    // ---- 국서방 할 일: 같은 국서 사람만 보고, 회장단(국서 목록 맨 위)은 모든 국서 방을 봄
    //   쓰기·고치기·지우기: 그 국서의 국장, 회장·부회장, 회장단 권한자
    //   국원: 자기에게 맡겨진 일(여러 명 중 한 명이어도 됨, 또는 국서 전체 일)의 '완료' 체크만
    function siteVal(k, d) { return exists(siteDoc()) ? get(siteDoc()).data.get(k, d) : d; }
    function execDeptName() { return siteVal('depts', ['회장단'])[0]; }
    // 국서 대표 직책: 직책 목록에서 회장단 직책(회장·부회장)을 뺀 첫 번째 (기본: 국장)
    function headPosition() {
      return siteVal('positions', ['국장', '국원']).removeAll(siteVal('execPositions', ['회장', '부회장']))[0];
    }
    function isExecPos() { return approved() && hasProfile() && me().position in siteVal('execPositions', ['회장', '부회장']); }
    function isDeptHeadPos() { return me().position == '국장' || me().position == headPosition(); }
    // 회장·부회장·국장 (사업 추가·수정·삭제)
    function isHead() { return approved() && hasProfile() && (isDeptHeadPos() || isExecPos()); }
    // 그 국서의 업무를 관리할 수 있는 사람: 회장단 권한자, 회장·부회장, 그 국서의 국장
    function canManage(d) {
      return admin() || isExecPos() || (approved() && hasProfile() && me().dept == d && isDeptHeadPos());
    }
    function roomViewer(d) { return approved() && hasProfile() && (me().dept == d || me().dept == execDeptName()); }
    function roomHead(d) { return canManage(d); }
    // ---- 재무국방 · 추가 정산 (합동응원전 뒤풀이 등): 재무국 전원 + 회장단 ----
    match /settlements/{id} {
      allow read, create, update, delete: if admin() || isExecPos()
        || (approved() && hasProfile() && (me().dept.matches('.*재무.*') || me().dept == execDeptName()));
    }
    match /deptTasks/{id} {
      allow read: if admin() || roomViewer(resource.data.dept);
      allow create: if admin() || (roomHead(request.resource.data.dept)
        && request.resource.data.createdBy == request.auth.uid);
      allow update: if admin()
        || (roomHead(resource.data.dept) && request.resource.data.dept == resource.data.dept)
        || (approved() && hasProfile() && me().dept == resource.data.dept
            && (request.auth.uid in resource.data.get('assigneeUids', [])
                || resource.data.get('assigneeUid', '') == request.auth.uid
                || (resource.data.get('assigneeUid', '') == '' && resource.data.get('assigneeUids', []).size() == 0))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'doneBy']));
      allow delete: if admin() || roomHead(resource.data.dept);
    }

    // ---- 회장단 공지 (홈 맨 위): 활동 중인 회원이 읽고, 회장단만 올리고 고침
    match /notices/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    // ---- 사이트 설정 (국 목록 등) ----
    //   settings/public 에는 학생회 기수·이름만 있음 → 로그인 화면에 보여 주려고 누구나 읽기 가능
    match /settings/{doc} {
      allow read: if signedIn() || doc == 'public';
      allow write: if admin();
    }

    // ---- 회의록: 승인된 회원 누구나 작성/수정, 삭제는 작성자 또는 회장단 ----
    // 업무 캘린더 업무: 모두 볼 수 있음
    //   추가·국서별 분배·수정·맡기기·삭제: 그 국서의 국장, 회장·부회장, 회장단 권한자
    //   국원: 우리 국서 업무의 '완료' 체크만
    match /tasks/{id} {
      allow read: if approved();
      allow create: if canManage(request.resource.data.dept);
      allow update: if (canManage(resource.data.dept) && canManage(request.resource.data.dept))
        || (approved() && hasProfile() && me().dept == resource.data.dept
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt', 'doneBy']));
      allow delete: if canManage(resource.data.dept);
    }
    // 회의록: 지금 학생회 것은 모두, 지난 학생회 것은 그 학생회에 있었던 사람만 (OB 포함)
    match /minutes/{id} {
      allow read: if admin()
        || canSeeGen(resource.data.get('generation', ''))
        || (alumni() && wasIn(resource.data.get('generation', '')));
      allow create, update: if approved();
      allow delete: if admin() || (approved() && resource.data.createdBy == request.auth.uid);
    }
    // 사업: 추가·수정·삭제는 회장·부회장·국장과 회장단 권한자
    match /projects/{id} {
      allow read: if approved() || alumni();
      allow create, update, delete: if admin() || isHead();
    }

    // ---- 행사 신청 양식 (사업마다 하나, 문서 번호 = 사업 번호) ----
    //   양식: 누구나 읽기 (학생들이 로그인 없이 신청 페이지를 봄 — 개인정보 없음)
    //   만들기·고치기·지우기: 양식 담당 국서(ownerDept)의 모든 국원 + 회장단(회장·부회장·회장단 국서·회장단 권한자)
    function execMember() {
      return admin() || isExecPos() || (approved() && hasProfile() && me().dept == execDeptName());
    }
    //   양식 고치기: 회장단 + 양식 담당 국서(대협국 사업은 대협국, 그 외는 소통국) + 따로 지정한 담당자(editorUids)
    function formEditor(f) {
      return execMember() || (approved() && hasProfile() && (
        me().dept == f.get('ownerDept', '')
        || request.auth.uid in f.get('editorUids', [])));
    }
    function formHasFee(f) { return f.get('fee', 0) > 0 || f.get('feeUnpaid', 0) > 0 || f.get('fee2', 0) > 0; }
    // 담당자 지정: 회장단 + 양식 담당 국서의 국장
    function formHead(f) { return execMember() || (approved() && hasProfile() && me().dept == f.get('ownerDept', '') && isDeptHeadPos()); }
    // 명단 보기·출석 체크: 위 사람들 + (참가비를 받는 양식만) 재무국 + 회장단이 양식별로 추가한 사람(viewerUids)
    function formViewer(f) {
      return formEditor(f) || (approved() && hasProfile() && (
        (me().dept.matches('.*재무.*') && formHasFee(f))
        || request.auth.uid in f.get('viewerUids', [])
        || request.auth.uid in f.get('attendUids', [])));
    }
    // 출석 체크: 회장단 + 재무국장 + 회장단이 양식별로 지정한 사람(attendUids)
    function attendUser(f) {
      return attendSwitch(f) || (approved() && hasProfile() && request.auth.uid in f.get('attendUids', []));
    }
    function attendSwitch(f) {
      return execMember() || (approved() && hasProfile() && me().dept.matches('.*재무.*') && isDeptHeadPos());
    }
    function formChanged(k) { return request.resource.data.get(k, null) != resource.data.get(k, null); }
    match /forms/{fid} {
      allow read: if true;
      allow create: if formEditor(request.resource.data)
        && (execMember() || (request.resource.data.get('editorUids', []).size() == 0 && request.resource.data.get('viewerUids', []).size() == 0 && request.resource.data.get('attendUids', []).size() == 0));
      allow update: if formEditor(resource.data) && formEditor(request.resource.data)
        && (!formChanged('editorUids') || formHead(resource.data))
        && (!formChanged('viewerUids') || execMember())
        && (!formChanged('attendUids') || execMember())
        && (!formChanged('ownerDept') || execMember())
        && (!formChanged('attendOn') || attendSwitch(resource.data))
        // 출석 체크 켜기/끄기만 바꾸는 경우: 회장단 + 재무국장
        || (attendSwitch(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendOn']));
      allow delete: if formEditor(resource.data);

      function form() { return get(/databases/$(database)/documents/forms/$(fid)).data; }

      // 선착순 순서표: 접수 시각만 들어 있음(이름·학번 없음) → 누구나 개수를 세서 '내가 몇 번째인지' 볼 수 있음
      match /slots/{slotId} {
        allow read: if true;
        allow create: if form().get('open', false) == true
          && request.time.toMillis() >= form().get('startMs', 0)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if formViewer(form());
      }

      // 참여자 명단 (문서 번호 = 학번 → 같은 학번으로 두 번 신청 못 함)
      //   신청: 로그인 없이 누구나, 단 신청을 받는 중일 때만 / 시각은 서버 시계 / 입금·출석은 '아니오'로만
      //   보기·입금·출석 체크·지우기: formViewer (응답 내용 자체는 못 고침)
      match /responses/{sid} {
        allow create: if form().get('open', false) == true
          // 제출 시작 시각(선착순 6시 정각 등) 전에는 못 냄 — 서버 시계 기준
          && request.time.toMillis() >= form().get('startMs', 0)
          && sid.matches('^[0-9]{10}$')
          && request.resource.data.keys().hasOnly(['sid', 'name', 'depositName', 'answers', 'at', 'paid', 'attended', 'slotId', 'editKey', 'ownerUid'])
          // 구글 로그인 양식: 로그인한 본인 계정으로만, 계정 하나당 한 번(mine/계정)
          && (form().get('login', false) != true || (signedIn() && request.resource.data.get('ownerUid', '') == request.auth.uid
              && getAfter(/databases/$(database)/documents/forms/$(fid)/mine/$(request.auth.uid)).data.sid == sid))
          && (!('ownerUid' in request.resource.data) || (signedIn() && request.resource.data.ownerUid == request.auth.uid))
          && (!('editKey' in request.resource.data) || (request.resource.data.editKey is string && request.resource.data.editKey.size() >= 20 && request.resource.data.editKey.size() <= 64))
          && request.resource.data.sid == sid
          && request.resource.data.at == request.time
          && request.resource.data.paid == false && request.resource.data.attended == false
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && request.resource.data.depositName is string && request.resource.data.depositName.size() <= 40
          && request.resource.data.answers is map && request.resource.data.answers.size() <= 40;
        // 학생회가 직접 추가 (현장 추가 신청 등): 명단을 볼 수 있는 사람 누구나 · '직접 추가' 표시가 꼭 붙음
        allow create: if formViewer(form())
          && (sid.matches('^[0-9]{10}$') || sid.matches('^m[0-9a-z]{4,20}$'))
          && request.resource.data.keys().hasOnly(['sid', 'name', 'depositName', 'answers', 'at', 'paid', 'attended', 'manual', 'addedBy', 'addedByName'])
          && request.resource.data.manual == true && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.paid == false && request.resource.data.attended == false
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
          && request.resource.data.answers is map && request.resource.data.answers.size() <= 60;
        // 구글폼에서 가져온 명단: 양식을 고치는 사람이 한 줄씩 넣음 (입금·출석은 '아니오'로만)
        allow create: if form().get('imported', false) == true && formEditor(form())
          && (sid.matches('^[0-9]{10}$') || sid.matches('^r[0-9]{1,5}$'))
          && request.resource.data.keys().hasOnly(['sid', 'name', 'depositName', 'answers', 'at', 'paid', 'attended', 'imported'])
          && request.resource.data.paid == false && request.resource.data.attended == false
          && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.answers is map && request.resource.data.answers.size() <= 60;
        allow read, delete: if formViewer(form());
        // 구글 로그인 양식: 본인 응답은 본인이 볼 수 있음
        allow get: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
        // 출석 체크는 명단을 보는 사람 누구나, 입금·회비 납부 여부는 재무국만
        allow update: if (attendUser(form()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attended', 'attendedAt']))
          || (formViewer(form()) && (isOwner() || (approved() && hasProfile() && me().dept.matches('.*재무.*')))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'paidAt', 'duesUnpaid']))
        // 예전 응답도 고칠 수 있게: 양식을 고치는 사람이 수정 열쇠(editKey)만 넣어 줄 수 있음
          || (formEditor(form()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editKey'])
            && request.resource.data.editKey is string && request.resource.data.editKey.size() >= 20 && request.resource.data.editKey.size() <= 64)
        // 구글 로그인 양식: 본인이 학번·이름·전화번호·답까지 고칠 수 있음 (입금·출석·제출 시각은 그대로)
          || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid
            && form().get('open', false) == true && form().get('allowEdit', true) != false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sid', 'name', 'depositName', 'answers', 'editedAt'])
            && request.resource.data.editedAt == request.time
            && request.resource.data.sid is string && request.resource.data.sid.matches('^[0-9]{10}$')
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
            && request.resource.data.depositName is string && request.resource.data.depositName.size() <= 40
            && request.resource.data.answers is map && request.resource.data.answers.size() <= 40)
        // 학생이 자기 응답 고치기 (로그인 없음): 제출할 때 받은 '수정 링크'(edits/열쇠)를 같은 순간에 함께 고쳐야만 됨
        //   → 열쇠를 아는 사람(본인)만 고칠 수 있음. 입금·출석·학번·제출 시각은 못 바꿈
          || (form().get('open', false) == true && form().get('allowEdit', true) != false
            && resource.data.get('editKey', '') != ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'depositName', 'answers', 'editedAt'])
            && request.resource.data.editedAt == request.time
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
            && request.resource.data.depositName is string && request.resource.data.depositName.size() <= 40
            && request.resource.data.answers is map && request.resource.data.answers.size() <= 40
            && getAfter(/databases/$(database)/documents/forms/$(fid)/edits/$(resource.data.editKey)).data.touchedAt == request.time);
      }
      // 구글 로그인 양식: 계정별 '내가 낸 응답' 표시 (문서 번호 = 구글 계정)
      match /mine/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, delete: if formViewer(form());
        allow create: if signedIn() && request.auth.uid == uid && form().get('open', false) == true
          && request.resource.data.keys().hasOnly(['sid', 'at']) && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/forms/$(fid)/responses/$(request.resource.data.sid)).data.get('ownerUid', '') == uid;
      }
      // 응답 수정용 사본 (문서 번호 = 수정 링크의 열쇠, 길고 무작위라 본인만 앎)
      //   열쇠를 아는 사람만 한 개씩 읽을 수 있음(목록 보기는 명단 보는 사람만)
      match /edits/{key} {
        allow get: if true;
        allow list, delete: if formViewer(form());
        allow create: if form().get('open', false) == true
          && request.resource.data.keys().hasOnly(['sid', 'name', 'answers', 'touchedAt', 'slotId'])
          && request.resource.data.touchedAt == request.time
          && getAfter(/databases/$(database)/documents/forms/$(fid)/responses/$(request.resource.data.sid)).data.editKey == key
          && request.resource.data.get('slotId', '') == getAfter(/databases/$(database)/documents/forms/$(fid)/responses/$(request.resource.data.sid)).data.get('slotId', '');
        allow update: if form().get('open', false) == true && form().get('allowEdit', true) != false
          && request.resource.data.keys().hasOnly(['sid', 'name', 'answers', 'touchedAt', 'slotId'])
          && request.resource.data.sid == resource.data.sid
          && request.resource.data.get('slotId', '') == resource.data.get('slotId', '')
          && request.resource.data.touchedAt == request.time
          && getAfter(/databases/$(database)/documents/forms/$(fid)/responses/$(resource.data.sid)).data.editedAt == request.time;
      }
    }
  }
}
