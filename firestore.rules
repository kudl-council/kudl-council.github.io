rules_version = '2';

// ================================================================
//  학생회 사이트 보안 규칙
//  최고 관리자: 학생회 공용 gmail (js/config.js 의 ownerEmail 과 같아야 함)
//  공용 gmail을 바꾸게 되면 아래 주소와 config.js 를 함께 바꾸세요.
// ================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() { return 'kudl.council@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == ownerEmail().lower();
    }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(myDoc()).data; }
    function hasProfile() { return signedIn() && exists(myDoc()); }
    function approved() { return isOwner() || (hasProfile() && me().status == 'approved'); }
    // 임기를 마친 OB (탈퇴자는 제외): 사업 기록과 학생회 멤버 명단만 읽기 가능
    function alumni() {
      return hasProfile() && me().status == 'inactive' && me().get('inactiveReason', '') == '임기 종료';
    }
    function admin() { return isOwner() || (approved() && me().get('isAdmin', false) == true); }
    // 지금 학생회(관리 → 사이트 설정) / 내가 속했던 학생회(넘기기 때 기록됨) / 2학년 여부
    function siteDoc() { return /databases/$(database)/documents/settings/site; }
    function curGen() { return exists(siteDoc()) ? get(siteDoc()).data.get('generation', '') : ''; }
    function wasIn(g) { return g in me().get('generations', []); }
    // 지금 학생회 것은 활동 중인 모두, 지난 학생회 것은 그 학생회에 있었던 사람만
    function canSeeGen(g) { return approved() && (g == curGen() || (hasProfile() && wasIn(g))); }
    function senior() { return approved() && hasProfile() && me().get('grade', '') == '2학년'; }
    function unchanged(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }

    // ---- 회원 정보 (연락망) ----
    match /users/{uid} {
      // 본인 정보는 본인이, 전체 명단은 승인된 회원만
      allow read: if (signedIn() && request.auth.uid == uid) || approved();

      // 가입 신청: 본인 것만, 반드시 '승인 대기' 상태로 (공용계정은 예외)
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && (isOwner() || (request.resource.data.status == 'pending'
                          && request.resource.data.isAdmin == false
                          && request.resource.data.keys().hasOnly(['name', 'studentId', 'grade', 'dept', 'position',
                               'phone', 'obPhone', 'email', 'status', 'isAdmin', 'createdAt'])));

      // 수정: 회장단은 모두 가능 / 본인은 이름·학번·전화번호만
      //   - 학년·소속 국서·직책·지난 학생회 기록은 회장단만 바꿀 수 있음
      //     (1학년이 스스로 2학년으로 바꿔서 타임캡슐 등을 보는 것을 막음)
      //   - 승인 대기 중이거나 재신청할 때는 정보를 고칠 수 있음 (회장단이 확인 후 승인)
      //   - 상태 변경은 두 가지만: 스스로 탈퇴(활동 중 → 탈퇴), 재신청(종료·반려 → 승인 대기)
      allow update: if admin() || (
        signedIn() && request.auth.uid == uid
        && unchanged('email') && unchanged('generations') && unchanged('history')
        && (unchanged('isAdmin') || request.resource.data.isAdmin == false)
        && (
          // 승인 대기 중: 가입 정보 수정
          (resource.data.status == 'pending' && unchanged('status') && unchanged('inactiveReason'))
          // 활동 중·OB: 이름·학번·전화번호만
          || (unchanged('status') && unchanged('inactiveReason')
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['name', 'studentId', 'phone', 'obPhone', 'profileCheck', 'updatedAt']))
          // 학년이 비어 있던 예전 회원: 학년 한 번 입력
          || (resource.data.status == 'approved' && unchanged('status') && unchanged('inactiveReason')
              && resource.data.get('grade', '') == ''
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['grade', 'name', 'studentId', 'phone', 'obPhone', 'profileCheck', 'updatedAt']))
          // 스스로 탈퇴
          || (resource.data.status == 'approved'
              && request.resource.data.status == 'inactive'
              && request.resource.data.inactiveReason == '탈퇴'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'inactiveReason', 'isAdmin', 'phone', 'leftAt']))
          // 재신청 (다시 승인 대기로)
          || (resource.data.status in ['inactive', 'rejected']
              && request.resource.data.status == 'pending'
              && request.resource.data.isAdmin == false)
        )
      );

      allow delete: if admin();
    }

    // ---- 역대 학생회 기록 (멤버 이름·국·직책·번호) ----
    //   번호가 들어 있으므로 그 학생회 멤버였던 사람과 회장단만 볼 수 있음
    match /councils/{id} {
      allow read: if admin()
        || (signedIn() && request.auth.uid in resource.data.get('memberUids', []));
      allow write: if admin();
    }

    // ---- 선배들의 한마디 (공개된 것): 활동 중인 회원과 OB가 읽기
    //   OB는 바로 공개로 쓸 수 있음. 회장단은 인수인계 때 타임캡슐을 여기로 옮김
    //   그 학생회에 함께 있었던 후배(넘기기 후 남은 사람)와 쓴 사람만 읽기
    match /messages/{id} {
      allow read: if admin()
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (approved() && hasProfile() && wasIn(resource.data.generation));
      allow create: if admin()
        || ((approved() || alumni()) && request.resource.data.authorUid == request.auth.uid);
      allow update: if admin() || ((approved() || alumni())
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid);
      allow delete: if admin() || ((approved() || alumni())
        && resource.data.authorUid == request.auth.uid);
    }

    // ---- 타임캡슐 (봉인된 한마디): 2학년끼리만 읽고 씀. 인수인계 때 공개됨
    match /capsules/{id} {
      allow read: if admin()
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || (senior() && resource.data.generation == curGen());
      allow create: if senior() && request.resource.data.authorUid == request.auth.uid;
      allow update: if admin() || (approved()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid);
      allow delete: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ---- 소통방 자유게시판 · 댓글: 활동 중인 회원끼리
    match /talk/{id} {
      allow read: if admin() || canSeeGen(resource.data.generation);
      allow create: if approved() && request.resource.data.authorUid == request.auth.uid;
      allow update: if approved() && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if admin() || (approved() && resource.data.authorUid == request.auth.uid);
    }
    match /talkComments/{id} {
      allow read: if admin() || canSeeGen(resource.data.generation);
      allow create: if approved() && request.resource.data.authorUid == request.auth.uid;
      allow delete: if admin() || (approved() && resource.data.authorUid == request.auth.uid);
    }

    // ---- 사이트 설정 (국 목록 등) ----
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if admin();
    }

    // ---- 업무 · 회의록 · 사업: 승인된 회원 누구나 작성/수정, 삭제는 작성자 또는 회장단 ----
    match /tasks/{id} {
      allow read, create, update: if approved();
      allow delete: if admin() || (approved() && resource.data.createdBy == request.auth.uid);
    }
    // 회의록: 지금 학생회 것은 모두, 지난 학생회 것은 그 학생회에 있었던 사람만 (OB 포함)
    match /minutes/{id} {
      allow read: if admin()
        || canSeeGen(resource.data.get('generation', ''))
        || (alumni() && wasIn(resource.data.get('generation', '')));
      allow create, update: if approved();
      allow delete: if admin() || (approved() && resource.data.createdBy == request.auth.uid);
    }
    match /projects/{id} {
      allow read: if approved() || alumni();
      allow create, update: if approved();
      allow delete: if admin() || (approved() && resource.data.createdBy == request.auth.uid);
    }
  }
}
